# Copy to .env and fill in YOUR local Postgres password.
# Create the database first:  createdb -U postgres dealflow360
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/dealflow360?schema=public"

PORT=4000

# MUST be two different values. The portal boundary is enforced by the fact
# that a portal token cannot be verified with the internal secret.
JWT_SECRET="change-me-internal"
PORTAL_JWT_SECRET="change-me-portal-and-keep-it-different"
